# Database connection string for Neon (Postgres).
#
# In the Neon console: Connection details -> choose the "Pooled connection"
# branch. Use the pooled URL for the app. Copy it into .env.local (or into your
# host's environment variable settings) and replace the placeholders.
#
# Never commit the real URL. .env* is already in .gitignore.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Admin account creation. Only needed when running `npm run create-admin`.
# The script refuses to run without a password, and rejects weak ones, so this
# is deliberately blank. Generate a passphrase rather than typing one:
#
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# `npm run set-password` takes the same variables, plus CURRENT_PASSWORD to
# prove you are the account holder. Leave CURRENT_PASSWORD unset only when
# deliberately recovering access from the server.
CURRENT_PASSWORD=

# Only needed for `npm run smoke`. The suite refuses to run when SMOKE_PASSWORD
# does not match the password currently stored, so it cannot clobber a newer one.
SMOKE_USERNAME=admin
SMOKE_PASSWORD=
SMOKE_BASE_URL=http://localhost:3000
